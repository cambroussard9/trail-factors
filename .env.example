# Environment variables read by trail-factors. All are optional.
#
# Nothing loads this file automatically. Export the ones you need in your shell
# (e.g. `set -a; . ./.env; set +a`), or put them in the "env" block of your MCP
# client's server configuration. A RELATIVE path is resolved against the repo
# root, never the current directory. Copy to .env (gitignored) to keep your own.

# The DuckDB database. Default: data/ultra.duckdb (under TRAIL_FACTORS_DATA_DIR).
# The test suite runs its corpus tests only when this is set, and skips them
# otherwise. For tests, point it at a COPY of your database, never the live one.
# TRAIL_FACTORS_DB=data/ultra.duckdb

# Root of the data directory. Default: data
# TRAIL_FACTORS_DATA_DIR=data

# Raw activity files (.fit), weather and API caches. Default: data/raw
# TRAIL_FACTORS_RAW_DIR=data/raw

# USGS DEM tiles (*.tif). Default: data/dem
# TRAIL_FACTORS_DEM_DIR=data/dem

# Athlete-supplied state (window confirmations, segment names, notes, ride
# logs). Per-user and not rebuildable: back it up. Default: data/athlete
# TRAIL_FACTORS_ATHLETE_DIR=data/athlete

# Account-summary lookups (never ingested). Default: data/lookup
# TRAIL_FACTORS_LOOKUP_DIR=data/lookup

# Sync-job state file. Default: data/jobs.json
# TRAIL_FACTORS_JOBS_FILE=data/jobs.json

# Athlete configuration (see config/athlete.example.yaml).
# Default: config/athlete.yaml
# TRAIL_FACTORS_CONFIG=config/athlete.yaml

# Garmin OAuth token directory, written by `garmin-login`. Must be OUTSIDE the
# repo; a path inside it is refused. Default: ~/.garminconnect
# TRAIL_FACTORS_GARMIN_TOKENSTORE=~/.garminconnect

# Failed-login lockout state (a timestamp and an error string; no secret).
# Must be outside the repo. Default: ~/.garminconnect_auth_state.json
# TRAIL_FACTORS_GARMIN_AUTH_STATE=~/.garminconnect_auth_state.json

# Test-only: private golden outputs for tests/test_golden_pinning.py.
# Default: data/golden
# TRAIL_FACTORS_GOLDEN_DIR=data/golden
